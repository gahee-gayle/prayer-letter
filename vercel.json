{
  "version": 2,
  "routes": [
    { "src": "/(.*)", "headers": { "x-robots-tag": "noindex, nofollow, noarchive, noimageindex" }, "continue": true },
    { "src": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/", "dest": "/index.html" },
    { "src": "/home", "dest": "/index.html" },
    { "src": "/letters", "dest": "/letters.html" },
    { "src": "/letter", "dest": "/letter.html" },
    { "src": "/editor", "dest": "/editor.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
